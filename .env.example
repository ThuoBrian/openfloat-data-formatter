# OpenFloat Data Formatter Configuration
# Copy to .env and customize as needed

# Maximum airtime amount (KES) that triggers a warning
MAX_AMOUNT_THRESHOLD=10000

# Country code prepended to phone numbers
DEFAULT_COUNTRY_PREFIX=254

# Input column that becomes the output 'Account Name'. Leave unset and the app
# detects it from the headers (Staff ID, Respondent ID, Unique ID, ...); the
# Transform page also lets you pick it per upload.
#ACCOUNT_NAME_COLUMN=Staff ID

# Project code used to complete a short 'C# 38305' case reference into the full
# Remark. A project_code column in the upload takes precedence, row by row.
#PROJECT_CODE=22505AA

# Path to the OpenFloat template (relative to project root)
OPENFLOAT_TEMPLATE_PATH=docs/openfloat-transactions-template.xlsx
