# OpenFloat Data Formatter Configuration
# Copy to .env and customize as needed

# Maximum airtime amount (KES) that triggers a warning
MAX_AMOUNT_THRESHOLD=10000

# Country code prepended to phone numbers
DEFAULT_COUNTRY_PREFIX=254

# Path to the OpenFloat template (relative to project root)
OPENFLOAT_TEMPLATE_PATH=docs/openfloat-transactions-template.xlsx
