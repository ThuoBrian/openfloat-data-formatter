          "account_name_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Name Column",
            "description": "Column feeding 'Account Name'. Omit to detect it from the headers."
          },
          "project_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Code",
            "description": "Completes a short 'C#<case>' reference into the full Remark."
          },
          "column_overrides": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column Overrides",
            "description": "JSON object, canonical field → column, e.g. {\"amount\": \"Amount KES\"}."
          },
          "country_prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Prefix",
            "description": "1-3 digits. Omit for the .env value."
          },
          "max_amount_threshold": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Amount Threshold",
            "description": "Warn above this many KES. Omit for .env."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_preview_file_preview_post"
