{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenFloat Data Formatter",
    "description": "Transform Process Maker airtime exports into OpenFloat-ready uploads.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/settings": {
      "get": {
        "summary": "Ui Defaults",
        "description": "The values the app's controls start from: built-in defaults plus .env.",
        "operationId": "ui_defaults_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UiDefaults"
                }
              }
            }
          }
        }
      }
    },
    "/preview": {
      "post": {
        "summary": "Preview File",
        "description": "Everything the Transform page shows for one file and one set of choices.\n\nStateless on purpose: the app posts the file again whenever a choice\nchanges, so nothing from an upload outlives its request.",
        "operationId": "preview_file_preview_post",
        "parameters": [
          {
            "name": "x-openfloat-client",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Openfloat-Client"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_preview_file_preview_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadCheck"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/validate": {
      "post": {
        "summary": "Validate File",
        "description": "Validate a Process Maker CSV/Excel file without transforming it.\n\nReturns a JSON validation report with row counts, errors, and warnings.",
        "operationId": "validate_file_validate_post",
        "parameters": [
          {
            "name": "x-openfloat-client",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Openfloat-Client"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_validate_file_validate_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transform": {
      "post": {
        "summary": "Transform File",
        "description": "Transform a Process Maker CSV/Excel file into an OpenFloat-ready Excel file.\n\nReturns the transformed .xlsx file as a binary download.",
        "operationId": "transform_file_transform_post",
        "parameters": [
          {
            "name": "x-openfloat-client",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Openfloat-Client"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_transform_file_transform_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/rejected-rows": {
      "post": {
        "summary": "Rejected Rows",
        "description": "The rows that will be left out, in the file's own columns, with the reason.\n\nThis is what goes back to whoever compiled the export, so it carries their\nheaders rather than the canonical ones.",
        "operationId": "rejected_rows_rejected_rows_post",
        "parameters": [
          {
            "name": "x-openfloat-client",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Openfloat-Client"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_rejected_rows_rejected_rows_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/statement-report": {
      "post": {
        "summary": "Statement Report",
        "description": "Report on successful vs unsuccessful OpenFloat disbursements.\n\nAccepts one or more 'Transaction Statement' exports plus an optional\nProcess Maker input (enables reconciliation). Statement files are parsed\nin memory; a statement with structural problems lands in `errors` and\ndoes not fail the request — only a request where nothing parses is\nuseless, and even then the response is a valid (empty) report.\n\nJSON shape note: `remark_parts` serializes as a positional array\n(`[case_number, project_code, amount, activity_code]`) because\n`CaseRemarkParts` is a NamedTuple.",
        "operationId": "statement_report_statement_report_post",
        "parameters": [
          {
            "name": "x-openfloat-client",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Openfloat-Client"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_statement_report_statement_report_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/statement-report/workbook": {
      "post": {
        "summary": "Statement Workbook",
        "description": "Download the project leads' report (`kind=report`) or the finance sheet.",
        "operationId": "statement_workbook_statement_report_workbook_post",
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "report",
                "finance"
              ],
              "type": "string",
              "title": "Kind"
            }
          },
          {
            "name": "x-openfloat-client",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Openfloat-Client"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_statement_workbook_statement_report_workbook_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/shutdown": {
      "post": {
        "summary": "Shutdown",
        "description": "Stop the app. Replies first, so the page can say it has closed.",
        "operationId": "shutdown_shutdown_post",
        "parameters": [
          {
            "name": "x-openfloat-client",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Openfloat-Client"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Shutdown Shutdown Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
