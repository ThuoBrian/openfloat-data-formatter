      "CaseRemarkParts": {
        "prefixItems": [
          {
            "type": "string",
            "title": "Case Number"
          },
          {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Code"
          },
          {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity Code"
          }
        ],
        "type": "array",
        "maxItems": 4,
        "minItems": 1
      },
      "CaseRollup": {
        "properties": {
          "case_number": {
            "type": "string",
            "title": "Case Number"
          },
          "project_code": {
            "type": "string",
            "title": "Project Code",
            "default": ""
          },
          "activity_code": {
            "type": "string",
            "title": "Activity Code",
            "default": ""
          },
          "remark_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remark Amount"
          },
          "total_rows": {
            "type": "integer",
            "title": "Total Rows",
            "default": 0
          },
          "successful_count": {
            "type": "integer",
            "title": "Successful Count",
            "default": 0
          },
          "unsuccessful_count": {
            "type": "integer",
            "title": "Unsuccessful Count",
            "default": 0
          },
          "disbursed_total": {
            "type": "number",
            "title": "Disbursed Total",
            "default": 0.0
          },
          "difference": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Difference"
          }
        },
        "type": "object",
        "required": [
          "case_number"
        ],
        "title": "CaseRollup",
        "description": "Per-case aggregation keyed by the parsed case_remark in the Remark column.\n\nThe amount embedded in the remark (`AIRTIME-KSH<amount>`) is the per-case\ntotal, so `difference` (disbursed_total - remark_amount) is the meaningful\nshortfall/overage flag, not a per-row comparison.\n\nA remark typed in the short `C#<case_number>` form carries no amount,\nproject code or activity code, so `remark_amount` and `difference` are None\nfor those cases: the rows still roll up and total, there is simply nothing\nto compare the disbursed figure against."
      },
      "FilteredCounts": {
        "properties": {
          "invalid_phone": {
            "type": "integer",
            "title": "Invalid Phone",
            "default": 0
          },
          "invalid_amount": {
            "type": "integer",
            "title": "Invalid Amount",
            "default": 0
          },
          "unmapped_network": {
            "type": "integer",
            "title": "Unmapped Network",
            "default": 0
          }
        },
        "type": "object",
        "title": "FilteredCounts",
        "description": "Count of rows filtered out by each validation rule."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IssueSeverity": {
        "type": "string",
        "enum": [
          "error",
          "warning"
        ],
        "title": "IssueSeverity",
        "description": "Severity of a validation issue."
      },
      "ReconciliationEntry": {
        "properties": {
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "unique_id": {
            "type": "string",
            "title": "Unique Id",
            "default": ""
          },
          "input_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Amount"
          },
          "input_row_numbers": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Input Row Numbers"
